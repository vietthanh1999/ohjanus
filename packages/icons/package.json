{
  "name": "@ohjanus/icons",
  "version": "0.1.0",
  "description": "JetBrains-style icon system for OhJanus UI Kit",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": "./src/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/sync-svelte-dist.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.5.0"
  }
}
