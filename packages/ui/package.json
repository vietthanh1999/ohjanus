{
  "name": "@ohjanus/ui",
  "version": "0.1.0",
  "description": "Styled Svelte 5 component catalog for OhJanus",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./*": "./dist/*"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@ohjanus/tokens": "workspace:*",
    "@ohjanus/icons": "workspace:*",
    "@ohjanus/primitives": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.5.0"
  }
}
