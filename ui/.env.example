# Admin API base URL (janus serve with admin.enabled: true, default :8788)
VITE_API_BASE_URL=http://127.0.0.1:8788

# Bearer token for the Admin API (interim auth until login/session lands).
# Must belong to a token with admin scope for approve/reject + token management.
# NEVER commit a real secret here.
VITE_ADMIN_TOKEN=
